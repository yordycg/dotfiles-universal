# =============================================================================
# Capa 5: Activación de Herramientas del Sistema (Mise, Zoxide, Starship, etc.)
# =============================================================================

# powerprofilesctl: el python3 del PATH es de mise (sin modulo 'gi') y rompe el
# cliente. Forzar el interprete del sistema (/usr/bin/python, python 3.14).
if command -v powerprofilesctl &>/dev/null; then
    powerprofilesctl() { /usr/bin/python /usr/bin/powerprofilesctl "$@"; }
fi

if command -v mise &>/dev/null; then
    run_cached "mise" "mise activate zsh" "Mise"
fi
command -v direnv  &>/dev/null && run_cached "direnv" "direnv hook zsh" "Direnv"
command -v zoxide  &>/dev/null && run_cached "zoxide" "zoxide init zsh" "Zoxide"
command -v starship &>/dev/null && run_cached "starship" "starship init zsh" "Starship"
if command -v atuin &>/dev/null; then
    run_cached "atuin" "atuin init zsh --disable-up-arrow" "Atuin"
fi
