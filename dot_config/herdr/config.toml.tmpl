{{- /* ══════════════════════════════════════════════════════════════
     dot_config/herdr/config.toml.tmpl
     Herdr — Terminal Workspace Manager (Agent-Native)
     Tema: "terminal" hereda la paleta ANSI de kitty (sistema de themes)
     ══════════════════════════════════════════════════════════════ */ -}}

onboarding = false

[theme]
# "terminal" → sigue la paleta ANSI del terminal host (kitty).
# Tus themes externos (dot_config/themes) se aplican via kitty en caliente.
name = "terminal"

[terminal]
new_cwd = "follow"

[worktrees]
directory = "~/workspace/worktrees"

[session]
resume_agents_on_restore = true

[keys]
prefix = "ctrl+b"
# Settings por defecto es prefix+s; lo libero para sessionizer.
settings = "prefix+shift+s"

# --- Acordes directos (familia segura ctrl+alt) + prefix ---
# La navegación ctrl+h/j/k/l la gestiona el plugin vim-herdr-navigation.
focus_pane_left  = "prefix+h"
focus_pane_down  = "prefix+j"
focus_pane_up    = "prefix+k"
focus_pane_right = "prefix+l"
previous_tab     = ["prefix+p", "ctrl+alt+["]
next_tab         = ["prefix+n", "ctrl+alt+]"]
new_tab          = ["prefix+c", "ctrl+alt+c"]
split_vertical   = ["prefix+v", "ctrl+alt+d"]
split_horizontal = ["prefix+minus", "ctrl+alt+shift+d"]
zoom             = ["prefix+z", "ctrl+alt+z"]
cycle_pane_next  = ["prefix+tab", "ctrl+alt+tab"]
workspace_picker = ["prefix+w", "ctrl+alt+w"]
goto             = ["prefix+g", "ctrl+alt+g"]
switch_workspace = "prefix+shift+1..9"
focus_agent      = "prefix+alt+1..9"

# --- Plugin actions: vim-herdr-navigation (Ctrl+h/j/k/l) ---
[[keys.command]]
key = "ctrl+h"
type = "plugin_action"
command = "vim-herdr-navigation.left"
description = "navigate left (vim/herdr)"

[[keys.command]]
key = "ctrl+j"
type = "plugin_action"
command = "vim-herdr-navigation.down"
description = "navigate down (vim/herdr)"

[[keys.command]]
key = "ctrl+k"
type = "plugin_action"
command = "vim-herdr-navigation.up"
description = "navigate up (vim/herdr)"

[[keys.command]]
key = "ctrl+l"
type = "plugin_action"
command = "vim-herdr-navigation.right"
description = "navigate right (vim/herdr)"

# --- Plugin actions: herdr-sessionizer (fzf pickers) ---
[[keys.command]]
key = "prefix+s"
type = "plugin_action"
command = "sessionizer.open"
description = "open project workspace"

[[keys.command]]
key = "prefix+f"
type = "plugin_action"
command = "sessionizer.worktree-open"
description = "open worktree workspace"

# --- Plugin actions: persiyanov.reviewr (revisar diffs de agentes) ---
[[keys.command]]
key = "prefix+alt+r"
type = "plugin_action"
command = "persiyanov.reviewr.open"
description = "open reviewr pane"

# --- Plugin actions: herdr-file-viewer (Previsualizador de archivos) ---
[[keys.command]]
key = "prefix+alt+f"
type = "plugin_action"
command = "herdr-file-viewer.open-file-viewer"
description = "open file viewer panel"

# --- Plugin actions: herdr-bar (Barra de estado de Herdr) ---
[[keys.command]]
key = "prefix+alt+b"
type = "plugin_action"
command = "herdr-bar.open"
description = "toggle herdr bar status"

# --- Popups (Custom Commands) ---

[[keys.command]]
key = "prefix+alt+g"
type = "popup"
command = "lazygit"
description = "lazygit"
width = "80%"
height = "80%"

[[keys.command]]
key = "prefix+alt+t"
type = "popup"
command = "exec \"${SHELL:-sh}\""
description = "scratch terminal"
width = "80%"
height = "80%"

[[keys.command]]
key = "prefix+alt+o"
type = "popup"
command = "opencode"
description = "opencode"
width = "80%"
height = "80%"

[[keys.command]]
key = "prefix+alt+d"
type = "pane"
command = "lazydocker"
description = "lazydocker"

[ui]
pane_borders = true
pane_gaps = true
tab_bar_position = "bottom"
sidebar_start_collapsed = false
# Agent panel ordering: "spaces" (grouped by space) or "priority" (attention queue).
agent_panel_sort = "spaces"

[ui.sidebar.agents]
rows = [
  ["state_icon", "workspace"],
  ["agent", "state_text"],
]

[ui.sidebar.spaces]
rows = [
  ["state_icon", "workspace"],
  ["branch", "git_status"],
]



[ui.toast]
delivery = "system"
delay_seconds = 1

{{- if eq .node.profile "laptop" }}
# ── ECO MODE (Laptop): sin sonido, scrollback reducido ──
[ui.sound]
enabled = false

[advanced]
scrollback_limit_bytes = 5000000
{{- else }}
# ── FULL MODE (Desktop): feedback sonoro + scrollback amplio ──
[ui.sound]
enabled = true
{{- end }}