[projects]
# Escaneo en vivo de ~/workspace (git_only): nuevos repos aparecen solos,
# sin índices ni scripts. wallpapers vive fuera del workspace (no es proyecto);
# dotfiles entra vía el symlink assets/dotfiles -> ~/.local/share/chezmoi.
roots = ["~/workspace"]
git_only = true
depth = 2

[ui]
placement = "overlay"

[layout]
# focus siempre el editor (`nv` -> nvim-personal)
focus = "editor"

# Layout por defecto (2 tabs):
#   dev     = nv | opencode (50/50) + terminal abajo (20%, full width)
#   lazygit = en pestaña propia, a pantalla completa
[tabs.dev]
label = "dev"

#   +------------------------------+------------------+
#   |   nvim (nv)                  |   opencode 50%   |
#   +------------------------------+------------------+
#   |              terminal (20%, full width)         |
#   +-------------------------------------------------+
[[tabs.dev.panes]]
id = "editor"
title = "nvim"
command = "nv"

[[tabs.dev.panes]]
id = "terminal"
from = "editor"
title = "terminal"
split = "down"
ratio = 0.20
command = "exec \"${SHELL:-sh}\""

[[tabs.dev.panes]]
id = "agent"
from = "editor"
title = "opencode"
split = "right"
ratio = 0.5
command = "opencode"

[tabs.lazygit]
label = "lazygit"

[[tabs.lazygit.panes]]
id = "git"
title = "lazygit"
command = "lazygit"
