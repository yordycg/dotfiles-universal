{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "small_model": "deepseek/deepseek-v4-flash",
  "default_agent": "plan",
  "lsp": true,
  "mcp": {
    "fff": {
      "type": "local",
      "command": ["fff-mcp"],
      "enabled": true
    }
  },
  "provider": {
    "openrouter": {
      "whitelist": ["anthropic/claude-sonnet-4.6"]
    }
  },
  "agent": {
    "build": {
      "color": "#81a1c1"
    },
    "plan": {
      "color": "#a3be8c"
    },
    "explore": {
      "model": "google/gemini-3.5-flash"
    }
  }
}
