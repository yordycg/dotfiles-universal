# ── Foot Terminal Configuration ───────────────────────────────────────────────

# --- Font & Layout ---
# foot resuelve bold/italic automáticamente por fontconfig dentro de la misma
# familia; NO existen claves bold-font/italic-font en foot.
font=JetBrainsMono Nerd Font:size=13
pad=20x20

[mouse]
hide-when-typing=yes

[cursor]
style=block
blink=no

[scrollback]
lines=10000

[colors-dark]
{{- if eq .node.profile "laptop" }}
alpha=1.0
{{- else }}
# alpha=0.90
alpha=1.00
{{- end }}

# --- Koda Dark Monochrome Palette ---
foreground=a6a6a6
background=080808

regular0=000000  # black
regular1=4a4a4a  # red
regular2=5c5c5c  # green
regular3=666666  # yellow
regular4=707070  # blue
regular5=7a7a7a  # magenta
regular6=848484  # cyan
regular7=a6a6a6  # white

bright0=3d3d3d    # bright black
bright1=686868    # bright red
bright2=a6a6a6    # bright green
bright3=b0b0b0    # bright yellow
bright4=b8b8b8    # bright blue
bright5=d0d0d0    # bright magenta
bright6=c0c0c0    # bright cyan
bright7=e0e0e0    # bright white
