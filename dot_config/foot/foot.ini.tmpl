# ── Foot Terminal Configuration ───────────────────────────────────────────────
# Integración declarativa con DMS: importa la paleta de colores gestionada
# por matugen en tiempo real desde DankMaterialShell (temas y wallpaper).
include=~/.config/foot/dank-colors.ini

# --- Font & Layout ---
# foot resuelve bold/italic automáticamente por fontconfig dentro de la misma
# familia; NO existen claves bold-font/italic-font en foot.
font=JetBrainsMono Nerd Font:size=13
pad=20x20

[mouse]
hide-when-typing=yes

[cursor]
style=block
blink=no

[scrollback]
lines=10000

[colors-dark]
{{- if eq .node.profile "laptop" }}
alpha=1.0
{{- else }}
# alpha=0.90
alpha=1.00
{{- end }}
