// ~/.config/zed/keymap.json

[
  // -----------------------------------------------------------------
  // Explorador de proyecto: reemplaza tus 2 reglas (toggle sidebar +
  // focusFilesExplorer) por una sola acción "toggle + focus".
  // -----------------------------------------------------------------
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-e": "project_panel::Toggle",
      "ctrl-t": "terminal_panel::Toggle",
      "ctrl-shift-'": "workspace::NewTerminal"
    }
  },

  // Reveal del archivo actual en el árbol (lo que antes hacía tu ctrl+b)
  {
    "context": "!AcpThread > Editor && mode == full",
    "bindings": {
      "ctrl-b": "pane::RevealInProjectPanel"
    }
  },

  // -----------------------------------------------------------------
  // Estilo NERDTree
  // -----------------------------------------------------------------
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste"
    }
  },

  // -----------------------------------------------------------------
  // Expand region
  // -----------------------------------------------------------------
  {
    "context": "Editor",
    "bindings": {
      "ctrl-w": "editor::SelectLargerSyntaxNode",
      "ctrl-shift-a": "editor::SelectSmallerSyntaxNode"
    }
  },

  // -----------------------------------------------------------------
  // Terminal
  // -----------------------------------------------------------------
  {
    "context": "Terminal",
    "bindings": {
      "shift-a": "pane::ActivateNextItem",
      "shift-b": "pane::ActivatePreviousItem",
      "shift-n": "workspace::NewTerminal"
    }
  }
]
