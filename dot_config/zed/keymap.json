// ~/.config/zed/keymap.json

[
  // -----------------------------------------------------------------
  // Explorador de proyecto: reemplaza tus 2 reglas (toggle sidebar +
  // focusFilesExplorer) por una sola acción "toggle + focus".
  // -----------------------------------------------------------------
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-e": "project_panel::ToggleFocus",
      "ctrl-t": "terminal_panel::ToggleFocus", // REVISAR nombre de acción
      "ctrl-shift-'": "workspace::NewTerminal"
    }
  },

  // Reveal del archivo actual en el árbol (lo que antes hacía tu ctrl+b)
  {
    "context": "Editor",
    "bindings": {
      "ctrl-b": "project_panel::RevealInProjectPanel" // REVISAR nombre exacto
    }
  },

  // -----------------------------------------------------------------
  // Estilo NERDTree: shortcuts de una sola letra cuando el explorador
  // tiene el foco (igual que tenías en VSCode con filesExplorerFocus).
  // "not_editing" evita que disparen mientras estás escribiendo el
  // nombre de un archivo/carpeta nuevo. REVISAR ese predicado exacto.
  // -----------------------------------------------------------------
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Trash", // o project_panel::Delete si preferís sin papelera
      "c": "project_panel::Copy",
      "p": "project_panel::Paste"
    }
  },

  // -----------------------------------------------------------------
  // Expand region
  // -----------------------------------------------------------------
  {
    "context": "Editor",
    "bindings": {
      "ctrl-w": "editor::SelectLargerSyntaxNode",
      "ctrl-shift-a": "editor::SelectSmallerSyntaxNode"
    }
  },

  // -----------------------------------------------------------------
  // Terminal
  // -----------------------------------------------------------------
  {
    "context": "Terminal",
    "bindings": {
      "shift-a": "pane::ActivateNextItem", // REVISAR nombre de acción
      "shift-b": "pane::ActivatePreviousItem", // REVISAR nombre de acción
      "shift-n": "workspace::NewTerminal"
    }
  }
]
