// ~/.config/zed/settings.json

{
  "base_keymap": "VSCode",
  "vim_mode": true,

  // ---------------------------------------------------------------------
  // TEMA / ICONOS
  // ---------------------------------------------------------------------
  "theme": {
    "mode": "dark",
    "dark": "Gruvbox Material",
    "light": "Gruvbox Material",
  },
  "icon_theme": "Material Icon Theme",

  // ---------------------------------------------------------------------
  // FUENTES
  // ---------------------------------------------------------------------
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_fallbacks": [".ZedMono"],
  "buffer_font_size": 16,
  "buffer_font_weight": 400,
  "buffer_line_height": "comfortable", // { "custom": 1.8 },
  "ui_font_size": 15,

  "terminal": {
    "font_family": "JetBrainsMono Nerd Font Mono",
    "font_size": 14,
    "blinking": "off",
    "copy_on_select": true,
    "dock": "bottom",
    "detect_venv": {
      "on": {
        "directories": [".venv", "venv", ".env", "env"],
        "activate_script": "default"
      }
    }
  },

  // ---------------------------------------------------------------------
  // FORMATEO / GUARDADO
  // ---------------------------------------------------------------------
  "tab_size": 4,
  "hard_tabs": false,
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "autosave": "on_focus_change",
  "format_on_save": "on",
  "formatter": "auto",

  "languages": {
    "TypeScript": {
      "tab_size": 2,
      "formatter": [
        "auto",
        { "code_action": "source.fixAll.eslint" },
        { "code_action": "source.organizeImports" }
      ]
    },
    "TSX": {
      "tab_size": 2,
      "formatter": [
        "auto",
        { "code_action": "source.fixAll.eslint" },
        { "code_action": "source.organizeImports" }
      ]
    },
    "JavaScript": {
      "tab_size": 2,
      "formatter": ["auto", { "code_action": "source.fixAll.eslint" }]
    },
    "JSX": {
      "tab_size": 2,
      "formatter": ["auto", { "code_action": "source.fixAll.eslint" }]
    },
    "JSON": { "tab_size": 2 },
    "Python": {
      "tab_size": 4,
      "formatter": "language_server"
    },
    "Markdown": {
      "remove_trailing_whitespace_on_save": false,
      "soft_wrap": "editor_width"
    },
    "Shell Script": {
      "formatter": {
        "external": { "command": "shfmt", "arguments": ["-i", "2"] }
      }
    },
    "C++": {
      "formatter": "language_server"
    }
  },

  // ---------------------------------------------------------------------
  // EDITOR: LAYOUT VISUAL
  // Sin minimap, sin scrollbar, sin breadcrumbs, números relativos
  // ---------------------------------------------------------------------
  "relative_line_numbers": "enabled",
  "current_line_highlight": "all",
  "cursor_shape": "bar",
  "cursor_blink": true,
  "multi_cursor_modifier": "cmd_or_ctrl",

  "minimap": { "show": "never" },
  "scrollbar": { "show": "never" },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": true,
    "selections_menu": true,
    "code_actions": false
  },

  "show_whitespaces": "none",
  "preferred_line_length": 100,
  "soft_wrap": "bounded",
  "wrap_guides": [100],
  "show_wrap_guides": true,

  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 1,
    "coloring": "fixed",
    "background_coloring": "disabled"
  },

  "gutter": {
    "line_numbers": true,
    "runnables": true,
    "breakpoints": true,
    "folds": false,
    "min_line_number_digits": 3
  },

  // ---------------------------------------------------------------------
  // COMPLETIONS / EDIT PREDICTIONS
  // ---------------------------------------------------------------------
  "show_completions_on_input": true,
  "show_completion_documentation": true,
  "hover_popover_enabled": true,
  "auto_signature_help": true,

  "completions": {
    "words": "fallback",
    "lsp": true,
    "lsp_insert_mode": "replace_suffix"
  },

  // Motor de predicciones activado, cambiar a "none" para apagar.
  "edit_predictions_disabled_in": ["comment", "string"],

  // ---------------------------------------------------------------------
  // GIT
  // ---------------------------------------------------------------------
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
      "delay_ms": 400
    },
    "branch_picker": { "show_author_name": true },
    "hunk_style": "staged_hollow"
  },

  // ---------------------------------------------------------------------
  // PANELES / LAYOUT (tu sidebar a la derecha, activity bar arriba)
  // ---------------------------------------------------------------------
  "project_panel": {
    "dock": "right",
    "file_icons": true,
    "folder_icons": true,
    "git_status": true,
    "indent_guides": { "show": "always" }
  },
  "git_panel": {
    "dock": "right",
    "status_style": "icon"
  },
  "outline_panel": {
    "dock": "right"
  },

  // ---------------------------------------------------------------------
  // ARCHIVOS / BÚSQUEDA
  // ---------------------------------------------------------------------
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/.next",
    "**/.cache",
    "**/dist",
    "**/build"
  ],

  "search": {
    "whole_word": false,
    "case_sensitive": false,
    "include_ignored": false,
    "regex": false
  },
  "use_smartcase_search": true,

  // ---------------------------------------------------------------------
  // TABS
  // ---------------------------------------------------------------------
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "close_position": "right",
    "activate_on_close": "history"
  },
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true
  },

  // ---------------------------------------------------------------------
  // VENTANA
  // ---------------------------------------------------------------------
  "title_bar": {
    "show_menus": false,
    "show_branch_name": true,
    "show_project_items": true
  },
  "confirm_quit": false,
  "restore_on_startup": "last_workspace",

  // ---------------------------------------------------------------------
  // TELEMETRÍA
  // ---------------------------------------------------------------------
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },

  // ---------------------------------------------------------------------
  // EXTENSIONES: se auto-instalan solas la primera vez que abrís Zed en
  // una máquina nueva. Sumá acá cualquier extensión nueva que instales
  // manualmente para que quede declarada en tus dotfiles.
  // ---------------------------------------------------------------------
  "auto_install_extensions": {
    "html": true,
    "gruvbox-material": true,
    "material-icon-theme": true,
    "dockerfile": true,
    "docker-compose": true,
    "csharp": true,
    "toml": true,
    "powershell": true,
    "sql": true,
    "ruff": true
  }
}
