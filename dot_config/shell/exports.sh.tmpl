# =============================================================================
# Capa 1: Variables de Entorno y Entorno Base
# Compatible con Bash y Zsh
# =============================================================================

# -- Colores Homelab-Style --
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

# -- Funciones de Logging (Senior UI) --
# Uso: log_ok "texto" "icono_opcional"
log_step() { echo -e "\n${CYAN}${BOLD}${2:-▶} $1${RESET}"; }
log_ok()   { echo -e "${GREEN}${2:-✓} $1${RESET}"; }
log_info() { echo -e "${CYAN}${2:-→} $1${RESET}"; }
log_warn() { echo -e "${YELLOW}${2:-⚠} $1${RESET}"; }
log_err()  { echo -e "${RED}${2:-✗} $1${RESET}"; }

# -- Terminal Compatibility Fix (Kitty Fallback) --
if [[ "$TERM" == "xterm-kitty" ]] && ! infocmp xterm-kitty >/dev/null 2>&1; then
    export TERM="xterm-256color"
fi

# -- Tmux Orphaned Session Cleanup (WSL/Persistent Terminals Fix) --
if [ -n "$TMUX" ]; then
    if [ ! -S "${TMUX%%,*}" ]; then
        unset TMUX
        unset TMUX_PANE
    fi
fi

# -- Wayland Stale Socket Recovery (Multiplexers / Session Restart Fix) --
if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    _xdg_run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    if [ ! -S "$_xdg_run/$WAYLAND_DISPLAY" ]; then
        for _sock in "$_xdg_run"/wayland-[0-9]*; do
            if [ -S "$_sock" ]; then
                export WAYLAND_DISPLAY="${_sock##*/}"
                break
            fi
        done
    fi
    unset _xdg_run _sock
fi


# -- Editores y Pager --
export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="bat"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
export MANOPT="--nh --nj"
export GROFF_NO_SGR=1
export MANROFFOPT="-c"

# -- Herdr: vim-herdr-navigation (passthrough de Ctrl+h/j/k/l a TUIs que los usan) --
export HERDR_NAV_PASSTHROUGH_RE='^(lazygit|lazydocker|yazi)$'

# -- Secretos y Seguridad --
export SOPS_AGE_KEY_FILE="$HOME/.config/chezmoi/key.txt"

# -- OTP (passage otp / pass-otp adaptado a age) --
export PASSWORD_STORE_ENABLE_EXTENSIONS=true

# -- FZF Configuration (Senior Modern UI) --
[ -f "$HOME/.config/shell/fzf_colors.sh" ] && source "$HOME/.config/shell/fzf_colors.sh"

export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git "
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type=d --hidden --strip-cwd-prefix --exclude .git"

export FZF_DEFAULT_OPTS=" \
  --height 45% \
  --layout=reverse \
  --border=rounded \
  --margin=0,1 \
  --padding=0 \
  --info=inline-right \
  --prompt='󰭎 ' \
  --pointer=' ' \
  --marker='󰄲 ' \
  ${FZF_COLORS:-} \
  --bind 'ctrl-u:preview-page-up,ctrl-d:preview-page-down' \
"

# -- Direnv Configuration (Invisible Automation) --
export DIRENV_LOG_FORMAT=""

# -- Homelab SSL / Trust (Capa de Infraestructura) --
{{ if eq .chezmoi.os "linux" -}}
{{   if eq .chezmoi.osRelease.id "fedora" -}}
HOMELAB_CA="/etc/pki/ca-trust/source/anchors/homelab-ca-bundle.crt"
{{   else -}}
HOMELAB_CA="/usr/local/share/ca-certificates/homelab-ca-bundle.crt"
{{   end -}}
[ -f "$HOMELAB_CA" ] && export NODE_EXTRA_CA_CERTS="$HOMELAB_CA"
{{ end -}}

# -- XDG Base Directory (Clean Host: cero dotfiles sueltos en $HOME) --
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# -- Runtimes & Build Tools: redirigir data/cache a XDG --
# mise gestiona los binarios y versiones; estas variables evitan que el
# runtime ensucie $HOME (CARGO/RUSTUP, GOPATH, NPM, .NET, etc.).
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export RUSTUP_HOME="$XDG_DATA_HOME/rustup"
export GOPATH="$XDG_DATA_HOME/go"
export GOMODCACHE="$GOPATH/pkg/mod"
export BUN_INSTALL="$XDG_DATA_HOME/bun"
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc"
export NPM_CONFIG_CACHE="$XDG_CACHE_HOME/npm"
export DOTNET_CLI_HOME="$XDG_DATA_HOME/dotnet"
export NUGET_PACKAGES="$XDG_DATA_HOME/NuGet/packages"
export CUDA_CACHE_PATH="$XDG_CACHE_HOME/nv"
export WGETRC="$XDG_CONFIG_HOME/wget/wgetrc"
export GTK2_RC_FILES="$XDG_CONFIG_HOME/gtk-2.0/gtkrc"

# -- Paths --
# Precedencia: Mise Shims > Binarios de Usuario (bin, .local/bin, opencode) > Sistema
# (Rust ya vive en $XDG_DATA_HOME/cargo gestionado por mise; no se añade ~/.cargo/bin.)
export PATH="$HOME/.local/share/mise/shims:$HOME/bin:$HOME/.local/bin:$HOME/.opencode/bin:$PATH"

# -- Theming: GTK & Qt Integration (Senior UI Consistency) --
{{ if eq .chezmoi.os "linux" -}}
{{   if ne .desktopEnv "kde" -}}
export QT_QPA_PLATFORMTHEME="qt5ct"
{{   end -}}
export QT_WAYLAND_DISABLE_WINDOWDECORATION="1"
export GDK_BACKEND="wayland,x11"
export SDL_VIDEODRIVER="wayland"
export CLUTTER_BACKEND="wayland"
{{ end -}}

# -- Starship Layout Configuration (Context-Aware) --
if [ -n "$SSH_CONNECTION" ]; then
    # Conexión remota por SSH: Usar prompt detallado
    export STARSHIP_CONFIG="$HOME/.config/starship/default.toml"
else
    # Entorno Local / Contenedores locales: Usar prompt minimalista
    export STARSHIP_CONFIG="$HOME/.config/starship/cyan-minimal.toml"
fi


