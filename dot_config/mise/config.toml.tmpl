# =============================================================================
# Mise — Fuente canónica de herramientas CLI (Clean Host)
#
# OBJETIVO PRINCIPAL: definir aquí las herramientas CLI para tener la MISMA
# versión (latest/pinned) en cada distro (Arch/Fedora/Debian). Los binarios del
# sistema (pacman/dnf/apt) no deben duplicar estas herramientas.
#
# NOTA HISTÓRICA: los runtimes (node, python, ...) se añadieron DESPUÉS, fuera
# del objetivo original, porque nvim requiere npm y pi (python+node); una vez
# dentro, se completó el resto de runtimes por coherencia.
#
# IMPORTANTE: la DATA/CACHE de los runtimes se redirige a XDG desde
# ~/.config/shell/exports.sh (CARGO_HOME, GOPATH, NPM_CONFIG_CACHE, ...).
# =============================================================================

[tools]
# --- Core CLI Tools (Universal) ---
neovim = "latest"
tmux = "latest"
starship = "latest"
lazygit = "latest"
lazydocker = "latest"
yazi = "latest"
fzf = "latest"
zoxide = "latest"
eza = "latest"
bat = "latest"
ripgrep = "latest"
fd = "latest"
ast-grep = "latest"
sd = "latest"
just = "latest"
gh = "latest"
btop = "latest"
fastfetch = "latest"
herdr = "latest"
jq = "latest"
yq = "latest"
age = "latest"
sops = "latest"
delta = "latest"
usage = "latest"
tree-sitter = "0.22.6"
direnv = "latest"

# --- Database & Data Engineering Tools ---
"github:xo/usql" = "latest"
"github:jorgerojas26/lazysql" = "latest"
uv = "latest"
duckdb = "latest"

# --- Lazy TUIs ---
"github:Lifailon/lazyjournal" = "latest"
"github:nghyane/lazyctl" = "1.2.1"

# --- Runtimes ---
node = "22"
bun = "latest"
python = "3.12"
lua = "5.1"
go = "latest"
dotnet = "latest"
rust = "latest"

[settings]
experimental = true
asdf_compat = true
python.github_attestations = false
all_compile = false
