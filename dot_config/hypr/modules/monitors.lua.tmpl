------------------
---- MONITORS ----
------------------

-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
{{- if eq .node.profile "desktop" }}
-- Monitor Principal (Acer Z271 a 144Hz)
hl.monitor({
	output = "DP-2",
	mode = "1920x1080@143.98",
	position = "0x0",
	scale = "1.00",
})

-- Monitor Secundario (HUAWEI AD80HW a 75Hz)
hl.monitor({
	output = "HDMI-A-1",
	mode = "1920x1080@74.97",
	position = "1920x0",
	scale = "1.00",
})

-- Nota: el mapa de workspaces (y su binding a monitor) vive en modules/workspaces.lua.tmpl
{{- else }}
-- Monitor en perfil laptop / escala 1.25 (125%)
hl.monitor({
	output = "",
	mode = "preferred",
	position = "auto",
	scale = "1.25",
})
{{- end }}
