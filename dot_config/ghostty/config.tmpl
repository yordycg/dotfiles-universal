# ── Ghostty Advanced Configuration ───────────────────────────────────────────
# Managed by Chezmoi

# --- Font & Layout ---
font-family = "JetBrainsMono Nerd Font"
font-style = "Regular"
font-style-bold = "Bold"
font-style-italic = "Italic"
font-style-bold-italic = "Bold Italic"
font-size = 13.0
font-thicken = false
adjust-cell-height = 12%
freetype-load-flags = no-hinting,no-autohint

# Custom rendering features (e.g. enabling ligatures)
font-feature = +calt
font-feature = +liga

# --- Window Layout & Behavior ---
window-padding-x = 24
window-padding-y = 24
window-decoration = false
window-inherit-working-directory = true
confirm-close-surface = false

# --- Scrollback ---
scrollback-limit = 10000

# --- Mouse & Clipboard ---
copy-on-select = clipboard
focus-follows-mouse = false

# --- Cursor Customization ---
cursor-style = block
cursor-style-blink = false
cursor-click-to-move = true

# --- Theme & Opacity ---
# Tema Oxocarbon (integrado en Ghostty). Terminal sólida: sin opacidad ni blur.
theme = Oxocarbon

# Transparencia y blur desactivados para terminal sólida
# background-opacity = 0.85
# background-blur = true
