# ── Ghostty Advanced Configuration ───────────────────────────────────────────
# Managed by Chezmoi

# --- Font & Layout ---
font-family = "GeistMono Nerd Font"
font-size = 13.0
font-thicken = true

# Custom rendering features (e.g. enabling ligatures)
font-feature = +calt
font-feature = +liga

# --- Window Layout & Behavior ---
window-padding-x = 20
window-padding-y = 20
window-decoration = false
window-inherit-working-directory = true
confirm-close-surface = false

# --- Scrollback ---
scrollback-limit = 10000

# --- Mouse & Clipboard ---
copy-on-select = clipboard
focus-follows-mouse = false

# --- Cursor Customization ---
cursor-style = block
cursor-style-blink = false
cursor-click-to-move = true

# --- Theme & Opacity ---
# Tema Ariadne (archivo en themes/ariadne). Terminal sólida: sin opacidad ni blur.
theme = ariadne

# Transparencia y blur desactivados para terminal sólida
# background-opacity = 0.85
# background-blur = true
