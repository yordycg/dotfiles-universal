{
  "main": {
    "prefix": "main",
    "body": ["int main(void) {", "\t${1:/* tu código */}", "\treturn 0;", "}"],
    "description": "Esqueleto main()"
  },
  "include": {
    "prefix": "inc",
    "body": ["#include <${1:stdio.h}>"],
    "description": "#include <...>"
  },
  "include local": {
    "prefix": "incl",
    "body": ["#include \"${1:header.h}\""],
    "description": "#include \"...\""
  },
  "for": {
    "prefix": "for",
    "body": ["for (${1:int i = 0}; ${2:i < n}; ${3:i++}) {", "\t${4}", "}"],
    "description": "bucle for"
  },
  "while": {
    "prefix": "while",
    "body": ["while (${1:condición}) {", "\t${2}", "}"],
    "description": "bucle while"
  },
  "if": {
    "prefix": "if",
    "body": ["if (${1:condición}) {", "\t${2}", "}"],
    "description": "condicional if"
  },
  "printf": {
    "prefix": "printf",
    "body": ["printf(\"${1:%s\\\\n}\", ${2:var});"],
    "description": "printf con salto de línea"
  },
  "scanf": {
    "prefix": "scanf",
    "body": ["scanf(\"${1:%d}\", &${2:var});"],
    "description": "scanf"
  },
  "return": {
    "prefix": "ret",
    "body": ["return ${1:0};"],
    "description": "return"
  }
}