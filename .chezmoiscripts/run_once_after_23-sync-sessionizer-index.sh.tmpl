{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# =============================================================================
# .chezmoiscripts/run_once_after_23-sync-sessionizer-index.sh.tmpl
# Genera el índice de proyectos de Sessionizer en ~/workspace/sessions:
# symlinks -> a cada repo git bajo ~/workspace/{assets,personal,work}//repo,
# excepto wallpapers, más el repo de dotfiles (~/.local/share/chezmoi).
# Idempotente (ln -sfn) y con poda de symlinks huérfanos.
# =============================================================================
set -euo pipefail

{{ include "provision/lib/logging.sh" }}

log_step "Índice de proyectos (Sessionizer)"

INDEX_DIR="${WORKSPACE_SESSIONIZER_INDEX:-$HOME/workspace/sessions}"
GROUPS_CAT=(assets personal work)
IGNORE=("wallpapers")

mkdir -p "$INDEX_DIR"

# --- 1. Symlinks por grupo ---------------------------------------------------
for group in "${GROUPS_CAT[@]}"; do
    group_dir="$HOME/workspace/$group"
    [[ -d "$group_dir" ]] || continue
    for repo in "$group_dir"/*; do
        [[ -d "$repo/.git" ]] || continue
        name="$(basename "$repo")"
        for ign in "${IGNORE[@]}"; do
            [[ "$name" == "$ign" ]] && continue 2
        done
        ln -sfn "$repo" "$INDEX_DIR/$name"
        log_ok "enlazado: ${group}/$name"
    done
done

# --- 2. Dotfiles (chezmoi) fuera del workspace -------------------------------
if [[ -d "$HOME/.local/share/chezmoi/.git" ]]; then
    ln -sfn "$HOME/.local/share/chezmoi" "$INDEX_DIR/dotfiles"
    log_ok "enlazado: dotfiles"
fi

# --- 3. Poda de symlinks huérfanos ------------------------------------------
while IFS= read -r link; do
    # -e sigue el symlink: broken symlinks fallan la prueba
    if [[ ! -e "$link" ]]; then
        rm -f "$link"
        log_warn "podado symlink huérfano: $link"
    fi
done < <(find "$INDEX_DIR" -maxdepth 1 -type l 2>/dev/null)

log_ok "Índice sessionizer listo (${INDEX_DIR})."
{{- end }}