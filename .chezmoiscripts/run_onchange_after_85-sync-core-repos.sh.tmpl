{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# =============================================================================
# scripts/run_after_85-sync-core-repos.sh.tmpl
# Sincronización de repositorios core de desarrollo y notas personales
# =============================================================================
set -euo pipefail

{{ include "provision/lib/logging.sh" }}

log_step "Proyectos Core de Desarrollo"

# Directorios de Destino
WALLPAPERS_DIR="$HOME/Pictures/Wallpapers"
PERSONAL_DIR="$HOME/workspace/personal"
OBSIDIAN_DIR="$PERSONAL_DIR/obsidian-notes"
LEARNING_DIR="$PERSONAL_DIR/learning-path"
BUSINESS_DIR="$PERSONAL_DIR/business-acumen"
AI_LEARNING_DIR="$PERSONAL_DIR/ai-learning-path"

# ── 1. Clonar Proyectos Personales / Notas ───────────────────────────────────
mkdir -p "$PERSONAL_DIR"

# Notas de Obsidian
if [ ! -d "$OBSIDIAN_DIR/.git" ]; then
    log_info "Clonando repositorio de Obsidian Notes en $OBSIDIAN_DIR..."
    run git clone "git@github.com:yordycg/obsidian-notes.git" "$OBSIDIAN_DIR" || log_warn "No se pudo clonar Obsidian Notes. Verifica conexión y llaves SSH."
fi

# Learning Path (Estudio)
if [ ! -d "$LEARNING_DIR/.git" ]; then
    log_info "Clonando repositorio de Aprendizaje en $LEARNING_DIR..."
    run git clone "git@github.com:yordycg/learning-path.git" "$LEARNING_DIR" || log_warn "No se pudo clonar Learning Path. Verifica conexión y llaves SSH."
fi

# Business Acumen (Roadmap de Negocios)
if [ ! -d "$BUSINESS_DIR/.git" ]; then
    log_info "Clonando repositorio de Business Acumen en $BUSINESS_DIR..."
    run git clone "git@github.com:yordycg/business-acumen.git" "$BUSINESS_DIR" || log_warn "No se pudo clonar Business Acumen. Verifica conexión y llaves SSH."
fi

# AI Learning Path (Roadmap de IA & SDD)
if [ ! -d "$AI_LEARNING_DIR/.git" ]; then
    log_info "Clonando repositorio de AI Learning Path en $AI_LEARNING_DIR..."
    run git clone "git@github.com:yordycg/ai-learning-path.git" "$AI_LEARNING_DIR" || log_warn "No se pudo clonar AI Learning Path. Verifica conexión y llaves SSH."
fi

# ── 2. Crear Symlink de Dotfiles en workspace/personal/ ─────────────────────
# El source real sigue en ~/.local/share/chezmoi; este symlink lo expone al
# picker de sessionizer (que escanea ~/workspace en vivo). Idempotente.
if [ ! -e "$PERSONAL_DIR/dotfiles" ]; then
    ln -sfn "$HOME/.local/share/chezmoi" "$PERSONAL_DIR/dotfiles"
    log_ok "Alias de dotfiles creado en $PERSONAL_DIR/dotfiles"
fi

# ── 3. Clonar Recursos Visuales (Solo si la máquina tiene GUI) ─────────────
if [ "{{ .hasGUI }}" = "true" ]; then
    if [ ! -d "$WALLPAPERS_DIR/.git" ]; then
        log_info "Clonando repositorio de Wallpapers en $WALLPAPERS_DIR..."
        mkdir -p "$(dirname "$WALLPAPERS_DIR")"
        run git clone "git@github.com:yordycg/wallpapers.git" "$WALLPAPERS_DIR" || log_warn "No se pudo clonar Wallpapers. Verifica conexión y llaves SSH."
    fi
fi

log_ok "Sincronización de repositorios core finalizada."
{{- end }}
