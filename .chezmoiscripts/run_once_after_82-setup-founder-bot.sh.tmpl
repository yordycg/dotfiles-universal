{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# =============================================================================
# .chezmoiscripts/run_once_after_82-setup-founder-bot.sh.tmpl
# Prepara el cockpit móvil del fundador:
#   - venv de python (uv, con fallback a python3) + dependencias
#   - habilita timers de systemd (briefing diario + TTS nocturno)
#   - habilita el servicio del bot SOLO si ya existe el .env de secretos
# Idempotente y tolerante: puede correr N veces sin romper nada.
# =============================================================================
set -euo pipefail

APP_DIR="$HOME/.local/share/founder-bot"
ENV_FILE="$HOME/.config/founder-bot/.env"
SRC_DIR="$APP_DIR/src"
VENV_DIR="$APP_DIR/.venv"
REQS="$APP_DIR/requirements.txt"

log()  { printf '\033[1;34m[founder-bot]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[founder-bot]\033[0m %s\n' "$*"; }

mkdir -p "$APP_DIR"

# ── 1. Crear venv (si falta) ────────────────────────────────────────────────
if [[ ! -x "$VENV_DIR/bin/python" ]]; then
    log "Creando venv en $VENV_DIR..."
    if command -v uv >/dev/null 2>&1; then
        uv venv --python 3.12 "$VENV_DIR" 2>/dev/null \
            || uv venv "$VENV_DIR"
    else
        python3 -m venv "$VENV_DIR"
    fi
fi

# ── 2. Instalar dependencias (tolerante: si falla, no aborta el resto) ──────
if [[ -f "$REQS" ]]; then
    log "Instalando dependencias..."
    if command -v uv >/dev/null 2>&1; then
        uv pip install --python "$VENV_DIR/bin/python" -r "$REQS" || warn "uv pip install falló; revisa red."
    else
        "$VENV_DIR/bin/pip" install --quiet -r "$REQS" || warn "pip install falló; revisa red."
    fi
else
    warn "No existe $REQS (¿chezmoi aplicó el código?)."
fi

# ── 3. Units de systemd ─────────────────────────────────────────────────────
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user daemon-reload 2>/dev/null || true

    for timer in founder-daily.timer founder-evening.timer; do
        if [[ -f "$HOME/.config/systemd/user/$timer" ]]; then
            systemctl --user enable "$timer" >/dev/null 2>&1 || warn "No pude habilitar $timer"
        else
            warn "Falta el unit $timer — corre: chezmoi apply"
        fi
    done

    if [[ -f "$ENV_FILE" ]]; then
        if [[ -f "$HOME/.config/systemd/user/founder-bot.service" ]]; then
            systemctl --user enable founder-bot.service >/dev/null 2>&1 \
                && log "founder-bot.service habilitado." \
                || warn "No pude habilitar founder-bot.service"
        fi
    else
        log "Sin .env todavía: el bot se habilitará al correr 'founder-env-setup'."
    fi
else
    warn "systemd no disponible (host futuro): los timers se activarán en el host definitivo."
fi

log "Setup founder-bot completado."
{{- end }}
