{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# =============================================================================
# .chezmoiscripts/run_once_after_29-setup-dms.sh.tmpl
# Post-instalación de DMS (DankMaterialShell): genera la configuración por
# defecto del shell (binds/colors/layout/... bajo ~/.config/niri/dms/).
# Idempotente: `dms setup` solo escribe archivos que no existen o están vacíos.
# El arranque del shell lo hace la config de niri (spawn-at-startup "dms" "run").
# =============================================================================
set -euo pipefail

{{ include "provision/lib/logging.sh" }}

log_step "Aprovisionamiento de DMS (DankMaterialShell)"

if ! has_cmd dms; then
    log_warn "dms no encontrado. Instala el paquete dms/dms-shell-niri vía la matriz de paquetes."
    exit 0
fi

DMS_VERSION="$(dms version 2>/dev/null | head -n 1 || true)"
log_ok "DMS instalado: ${DMS_VERSION:-versión desconocida}"

# 1. Generar la configuración por defecto del compositor (solo si falta).
#    Únicamente se despliega colors.kdl (red de seguridad con fondo transparente);
#    el tema real lo genera run_once_after_86 (dms matugen generate).
#    NO se ejecuta `dms setup` a secas: además de ser interactivo, despliega su
#    propio config.kdl y kitty.conf sobrescribiendo los archivos gestionados por
#    chezmoi. DMS_PRIVESC evita el prompt de herramienta de elevación y se
#    responde por stdin al selector de compositor (1 = niri).
export DMS_PRIVESC=sudo
for sub in colors; do
    if output=$(printf '1\n1\n' | dms setup "$sub" 2>&1); then
        log_ok "dms setup $sub: configurado."
    elif [[ "$output" == *"already exists"* ]]; then
        log_info "dms setup $sub: ya existía (omitido)."
    else
        log_warn "dms setup $sub falló: ${output##*$'\n'}"
    fi
done

# 2. Servicio de indexación de DankSearch (dsearch): opcional, tolerante.
if has_cmd dsearch; then
    if systemctl --user enable --now dsearch &>/dev/null; then
        log_ok "Servicio dsearch (indexación de archivos) habilitado."
    else
        log_warn "No se pudo habilitar el servicio dsearch; el spotlight usará apps sin búsqueda de archivos."
    fi
else
    log_info "dsearch no instalado; omitiendo indexación de archivos."
fi

log_ok "DMS configurado correctamente."
{{- end }}
