{{- if eq .node.distro "arch" -}}
#!/usr/bin/env bash
# =============================================================================
# .chezmoiscripts/run_onchange_after_26-install-aur-packages.sh.tmpl
# Instalación y actualización automática de paquetes del AUR
# =============================================================================
# Hash de la matriz de paquetes: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

set -euo pipefail

# Helper canónico del repo: yay (instalado por run_once_after_25); se acepta
# paru si el usuario lo tiene instalado manualmente.
if command -v yay &>/dev/null; then
    AUR_HELPER="yay"
elif command -v paru &>/dev/null && paru --version &>/dev/null; then
    AUR_HELPER="paru"
else
    echo "! Ningún helper de AUR funcional (yay/paru) encontrado. Revisa run_once_after_25-install-aur-helper. Omitiendo instalación de paquetes AUR."
    exit 0
fi

echo "→ Sincronizando paquetes de AUR usando $AUR_HELPER..."
$AUR_HELPER -S --noconfirm --needed {{ range .arch.aur }}{{ . }} {{ end }}
echo "✓ Paquetes de AUR sincronizados."
{{- end }}
