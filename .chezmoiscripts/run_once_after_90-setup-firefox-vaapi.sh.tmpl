{{- if and (eq .chezmoi.os "linux") .hasGUI -}}
#!/usr/bin/env bash
# =============================================================================
# .chezmoiscripts/run_once_after_90-setup-firefox-vaapi.sh.tmpl
# Habilita decodificación de video por hardware (VA-API / iHD) en todos los
# perfiles Firefox '*.default-release' del host (los nombres son aleatorios).
# Idempotente: inserta solo las claves ausentes en el user.js de cada perfil.
# =============================================================================
set -euo pipefail

{{ include "provision/lib/logging.sh" }}

FF_ROOT="$HOME/.mozilla/firefox"

if [ ! -d "$FF_ROOT" ]; then
    log_warn "Firefox no instalado; omitiendo configuracion VA-API."
    exit 0
fi

PREFS=(
    'user_pref("media.ffmpeg.vaapi.enabled", true);'
    'user_pref("media.hardware-video-decoding.enabled", true);'
    'user_pref("media.rdd-process.enabled", true);'
    'user_pref("media.ffmpeg.vaapi.dmabuf-textures.enabled", true);'
    'user_pref("widget.dmabuf.force-enabled", true);'
    'user_pref("gfx.webrender.all", true);'
)

count=0
for profile in "$FF_ROOT"/*.default-release; do
    [ -d "$profile" ] || continue
    userjs="$profile/user.js"
    touch "$userjs"
    changed=0
    for pref in "${PREFS[@]}"; do
        key="${pref%%:*}"            # user_pref("media.ffmpeg.vaapi.enabled"
        if ! grep -qF "$key" "$userjs"; then
            echo "$pref" >> "$userjs"
            changed=1
        fi
    done
    if [ "$changed" -eq 1 ]; then
        log_ok "VA-API habilitado en perfil: $profile"
    else
        log_info "VA-API ya configurado en: $profile"
    fi
    count=$((count + 1))
done

if [ "$count" -eq 0 ]; then
    log_warn "No se encontraron perfiles *.default-release en $FF_ROOT"
fi

# Nota: los prefs aplican al reiniciar Firefox.
log_ok "Firefox VA-API listo (reinicia Firefox para aplicar)."
{{- end }}
