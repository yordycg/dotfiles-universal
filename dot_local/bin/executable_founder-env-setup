#!/usr/bin/env bash
# founder-env-setup — crea ~/.config/founder-bot/.env (0600) y persiste los secretos
# en el passage store (~/.passage/store, cifrado con age) para restaurarlos tras un formateo.
#
# Orden de resolución de cada secreto:
#   1) variable de entorno ya definida
#   2) passage show founder/<name>
#   3) prompt interactivo (y guardado en passage)
#
# Uso: founder-env-setup            (interactivo)
#      FOUNDER_SKIP_SYSTEMD=1 founder-env-setup
set -euo pipefail

ENV_DIR="${FOUNDER_ENV_DIR:-$HOME/.config/founder-bot}"
ENV_FILE="$ENV_DIR/.env"
STORE="${PASSWORD_STORE_DIR:-$HOME/.passage/store}"
AGE_BIN="$(command -v age || true)"
PASSAGE_BIN="$(command -v passage || true)"
SKIP_SYSTEMD="${FOUNDER_SKIP_SYSTEMD:-0}"

VAULT_DEFAULT="$HOME/workspace/personal/obsidian-notes"
STATUS_DEFAULT="$HOME/workspace/personal/emprendimiento"

interactive=1
if [[ ! -t 0 ]]; then
    interactive=0
fi

log()  { printf '\033[1;34m[founder]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[founder]\033[0m %s\n' "$*"; }

persist_passage() {
    local pname="$1" val="$2"
    [[ -n "$val" ]] || return 0
    if [[ -n "$AGE_BIN" && -f "$STORE/.age-recipients" ]]; then
        local target="$STORE/$pname.age"
        mkdir -p "$(dirname "$target")"
        if printf '%s\n' "$val" | "$AGE_BIN" -R "$STORE/.age-recipients" -o "$target" 2>/dev/null; then
            chmod 600 "$target"
            git -C "$STORE" add "$target" >/dev/null 2>&1 || true
            git -C "$STORE" commit -q -m "founder-bot: add $pname" >/dev/null 2>&1 || true
            git -C "$STORE" push -q >/dev/null 2>&1 || true
        fi
    fi
}

resolve_secret() {
    local key="$1" pname="$2" prompt="$3" is_secret="${4:-0}"
    local val=""
    if [[ -n "${!key:-}" ]]; then
        val="${!key}"
        persist_passage "$pname" "$val"
    elif [[ -n "$PASSAGE_BIN" ]] && "$PASSAGE_BIN" show "$pname" >/dev/null 2>&1; then
        val="$("$PASSAGE_BIN" show "$pname")"
    else
        if [[ "$interactive" == "0" ]]; then
            warn "No interactivo y falta $key. Defínela en el entorno o corre founder-env-setup en una terminal."
            return 1
        fi
        if [[ "$is_secret" == "1" ]]; then
            read -rsp "$prompt: " val
            printf '\n'
        else
            read -rp "$prompt: " val
        fi
        persist_passage "$pname" "$val"
    fi
    printf '%s' "$val"
}

main() {
    local token chat_id groq_key vault_dir status_dir

    log "Configurando el cockpit móvil del fundador..."

    token="$(resolve_secret FOUNDER_TELEGRAM_TOKEN founder/telegram-token "Token del bot Telegram (de @BotFather)" 1)" || return 1
    chat_id="$(resolve_secret FOUNDER_CHAT_ID founder/chat-id "Tu chat_id de Telegram (mándale /start al bot y pega el número de la respuesta)" 0)" || return 1
    groq_key="$(resolve_secret FOUNDER_GROQ_API_KEY founder/groq-api-key "API key de Groq (console.groq.com)" 1)" || return 1

    vault_dir="${FOUNDER_VAULT_DIR:-$VAULT_DEFAULT}"
    status_dir="${FOUNDER_STATUS_DIR:-$STATUS_DEFAULT}"

    mkdir -p "$ENV_DIR"
    umask 077
    cat > "$ENV_FILE" <<EOF
# Generado por founder-env-setup — no editar a mano salvo necesidad.
FOUNDER_TELEGRAM_TOKEN=$token
FOUNDER_CHAT_ID=$chat_id
FOUNDER_GROQ_API_KEY=$groq_key
FOUNDER_VAULT_DIR=$vault_dir
FOUNDER_STATUS_DIR=$status_dir
EOF
    chmod 600 "$ENV_FILE"
    log "Env escrito: $ENV_FILE (0600)."

    if [[ "$SKIP_SYSTEMD" == "1" ]]; then
        log "FOUNDER_SKIP_SYSTEMD=1 → no toco systemd. Activa manualmente:"
        printf '  systemctl --user enable --now founder-bot.service\n'
        printf '  systemctl --user enable --now founder-daily.timer founder-evening.timer\n'
        return 0
    fi

    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user daemon-reload 2>/dev/null || true
        for unit in founder-daily.timer founder-evening.timer founder-bot.service; do
            if [[ -f "$HOME/.config/systemd/user/$unit" ]]; then
                systemctl --user enable "$unit" >/dev/null 2>&1 || warn "No pude habilitar $unit"
            else
                warn "Falta el unit $unit (corre: chezmoi apply)"
            fi
        done
        if [[ -f "$HOME/.config/systemd/user/founder-bot.service" ]]; then
            systemctl --user restart founder-bot.service >/dev/null 2>&1 || warn "El bot no arrancó; revisa: systemctl --user status founder-bot"
        fi
        log "Servicios y timers activados."
    fi

    log "Listo. Comandos útiles:"
    printf '  founder-bot                      # bot en foreground\n'
    printf '  founder-briefing                 # briefing manual\n'
    printf '  founder-evening                  # TTS manual\n'
    printf '  systemctl --user status founder-bot\n'
}

main "$@"
