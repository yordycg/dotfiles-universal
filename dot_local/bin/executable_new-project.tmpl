#!/usr/bin/env bash

# new-project
# Descripción: Crea la estructura ultra-limpia de un nuevo proyecto en el directorio actual.

set -e

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

PROJECT_NAME="$1"

if [ -z "$PROJECT_NAME" ]; then
    echo -e "${YELLOW}Uso: new-project <nombre_del_proyecto>${NC}"
    exit 1
fi

TARGET_DIR="$(pwd)/$PROJECT_NAME"

if [ -d "$TARGET_DIR" ]; then
    echo -e "Error: El directorio $TARGET_DIR ya existe."
    exit 1
fi

echo -e "${BLUE}Creando proyecto $PROJECT_NAME en $(pwd)...${NC}"

# Ruta a la plantilla en chezmoi
{{- $sourceDir := .chezmoi.sourceDir }}
TEMPLATE_DIR="{{ $sourceDir }}/scripts/templates/project-base"

mkdir -p "$TARGET_DIR"
cp -r "$TEMPLATE_DIR/"* "$TARGET_DIR/"
cp "$TEMPLATE_DIR/.gitignore" "$TARGET_DIR/" 2>/dev/null || true

cd "$TARGET_DIR"

# Inicializar Git
git init > /dev/null
git add .
git commit -m "chore: initial project setup" > /dev/null

echo -e "${GREEN}¡Proyecto $PROJECT_NAME creado exitosamente en $TARGET_DIR!${NC}"
echo ""
if command -v eza &>/dev/null; then
    eza --tree --icons --level=2 "$TARGET_DIR"
else
    ls -la "$TARGET_DIR"
fi
echo ""
echo -e "Siguiente paso: cd $PROJECT_NAME y abre TASKS.md para comenzar la Fase 0."
