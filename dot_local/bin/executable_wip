#!/usr/bin/env bash
# =============================================================================
# wip — Park / resume work in progress between machines via git.
#
#   wip park ["message"]   Commit all changes as WIP on a dedicated branch,
#                          push it to origin and return to the original branch.
#   wip resume [branch]    Fetch and apply the WIP commit(s) as staged changes
#                          on the current branch (no commit), so you keep the
#                          normal workflow and commit yourself.
#   wip done [branch] [--force]  Close the loop: verify the resumed work was
#                          committed, then delete the WIP branch (local+remote).
#   wip list               List local and remote WIP branches.
#   wip                    Show this help.
#
# WHY: `git stash` is local-only and cannot be pushed, so it never reaches
# another machine. A WIP commit is a real git object: it can be pushed to a
# remote and recovered later with `git reset --soft`, keeping main clean.
# =============================================================================
set -euo pipefail

# ---- helpers ----------------------------------------------------------------
if [ -t 1 ]; then
    C_RESET="\033[0m"
    C_OK="\033[1;32m"
    C_WARN="\033[1;33m"
    C_ERR="\033[1;31m"
    C_INFO="\033[1;34m"
else
    C_RESET=""
    C_OK=""
    C_WARN=""
    C_ERR=""
    C_INFO=""
fi

log_info() { printf "${C_INFO}[wip]${C_RESET} %s\n" "$*"; }
log_ok()   { printf "${C_OK}[wip]${C_RESET} %s\n" "$*"; }
log_warn() { printf "${C_WARN}[wip]${C_RESET} %s\n" "$*" >&2; }
log_err()  { printf "${C_ERR}[wip]${C_RESET} %s\n" "$*" >&2; }

repo_root() {
    git rev-parse --show-toplevel
}

require_repo() {
    if ! git rev-parse --show-toplevel >/dev/null 2>&1; then
        log_err "No estás dentro de un repositorio git."
        exit 1
    fi
}

# ---- usage ------------------------------------------------------------------
usage() {
    cat <<'EOF'
Uso:
  wip park ["mensaje"]   Parquea el trabajo actual en una rama wip/YYYYMMDD[-N]
                         y la pushea a origin. Vuelve a la rama original.
  wip resume [rama]      Retoma el trabajo: fetch y aplica los cambios staged en
                         la rama actual (sin commitear). Sigue el flujo normal.
  wip done [rama] [--force]  Cierra el ciclo: verifica que commiteaste el trabajo
                         y borra la rama wip local y remota (+ prune).
  wip list               Lista ramas wip locales y remotas.
  wip                    Muestra esta ayuda.

Ejemplos:
  wip park "s2 d2 read/write"
  wip resume
  wip done
EOF
}

# ---- list -------------------------------------------------------------------
cmd_list() {
    require_repo
    local found=0
    local ref
    while read -r ref; do
        log_info "$ref"
        found=1
    done < <(git for-each-ref --format='%(refname:short)' \
        refs/heads/wip/ refs/remotes/origin/wip/ 2>/dev/null)
    if [ "$found" -eq 0 ]; then
        log_info "No hay ramas wip/*."
    fi
}

# ---- park -------------------------------------------------------------------
cmd_park() {
    require_repo
    local root msg branch base orig_branch n candidate

    root="$(repo_root)"
    orig_branch="$(git branch --show-current)"
    if [[ "$orig_branch" == wip/* ]]; then
        log_err "Ya estás en la rama WIP '$orig_branch'. Usa 'wip resume' para retomar."
        exit 1
    fi

    if [ -z "$(git status --porcelain)" ]; then
        log_info "Working tree limpio en $root — nada que parquear."
        exit 0
    fi

    msg="${1:-$(date +%Y-%m-%d)}"
    base="wip/$(date +%Y%m%d)"
    n=1
    candidate="$base"
    while git show-ref --quiet --verify "refs/heads/$candidate" \
          || git show-ref --quiet --verify "refs/remotes/origin/$candidate"; do
        n=$((n + 1))
        candidate="${base}-${n}"
    done
    branch="$candidate"

    log_info "Creando rama $branch y commit 'WIP: $msg'..."
    git switch --quiet -c "$branch"
    git add -A
    git commit -m "WIP: $msg"
    git switch --quiet "$orig_branch"

    if git remote >/dev/null 2>&1; then
        if git push --quiet -u origin "$branch"; then
            log_ok "Pusheada a origin/$branch."
        else
            log_warn "No se pudo pushear origin/$branch. El commit queda local."
        fi
    else
        log_warn "El repo no tiene remote configurado. El commit queda local."
    fi

    log_ok "Parqueado en $root (rama $branch)."
    log_ok "En la otra máquina, tras 'chezmoi update':"
    printf "${C_OK}  cd %s && wip resume${C_RESET}\n" "$root"
}

# ---- resume -----------------------------------------------------------------
cmd_resume() {
    require_repo
    local branch subject local_name

    dirty="$(git status --porcelain)"
    if [ -n "$dirty" ]; then
        log_err "Working tree sucio. Commit o stash tus cambios antes de 'wip resume'."
        exit 1
    fi

    if git remote >/dev/null 2>&1; then
        git fetch --quiet origin || log_warn "fetch falló; usaré ramas locales."
    fi

    if [ -n "${1:-}" ]; then
        branch="$1"
        local_name="${branch#origin/}"
        if ! git show-ref --quiet --verify "refs/remotes/origin/$local_name" \
           && ! git show-ref --quiet --verify "refs/heads/$local_name"; then
            log_err "La rama '$branch' no existe."
            exit 1
        fi
    else
        branch="$(git for-each-ref --sort=-refname --format='%(refname:short)' \
            refs/remotes/origin/wip/ 2>/dev/null | head -n 1)"
        if [ -z "$branch" ]; then
            branch="$(git for-each-ref --sort=-refname --format='%(refname:short)' \
                refs/heads/wip/ 2>/dev/null | head -n 1)"
        fi
        if [ -z "$branch" ]; then
            log_info "No hay ramas wip/* para retomar."
            exit 0
        fi
        log_info "Rama WIP más reciente: $branch"
    fi

    current="$(git branch --show-current)"
    subject="$(git log -1 --format=%s "$branch")"
    if [[ "$subject" == WIP* ]]; then
        log_info "Aplicando cambios de $branch en '$current' (sin commitear)..."
        git merge --quiet --squash "$branch"
        log_ok "Cambios de $branch aplicados en '$current' (staged, sin commit)."
        log_ok "Trabaja y commitea normal; al terminar ejecuta: wip done"
    else
        log_info "El último commit de $branch no es WIP ('$subject'); merge normal..."
        git merge --quiet "$branch"
        log_ok "Rama $branch mergeada en '$current'."
        log_ok "Al terminar ejecuta: wip done"
    fi
    git status --short
}

# ---- done -------------------------------------------------------------------
cmd_done() {
    require_repo
    local branch local_name current dirty force=0

    while [[ "${1:-}" == --* ]]; do
        if [ "$1" = "--force" ]; then
            force=1
        else
            log_err "Opción desconocida: $1"
            exit 1
        fi
        shift
    done

    current="$(git branch --show-current)"
    if [[ "$current" == wip/* ]]; then
        log_err "Estás en la rama WIP '$current'. Vuelve a tu rama principal antes de 'wip done'."
        exit 1
    fi

    dirty="$(git status --porcelain)"
    if [ -n "$dirty" ]; then
        log_err "Working tree sucio. Commit o stash tus cambios antes de 'wip done'."
        exit 1
    fi

    if [ -n "${1:-}" ]; then
        branch="$1"
    else
        branch="$(git for-each-ref --sort=-refname --format='%(refname:short)' \
            refs/remotes/origin/wip/ 2>/dev/null | head -n 1)"
        if [ -z "$branch" ]; then
            branch="$(git for-each-ref --sort=-refname --format='%(refname:short)' \
                refs/heads/wip/ 2>/dev/null | head -n 1)"
        fi
    fi
    if [ -z "$branch" ]; then
        log_info "No hay ramas wip/* que limpiar."
        exit 0
    fi

    local_name="${branch#origin/}"
    if ! git show-ref --quiet --verify "refs/remotes/origin/$local_name" \
       && ! git show-ref --quiet --verify "refs/heads/$local_name"; then
        log_err "La rama '$branch' no existe."
        exit 1
    fi

    if [ "$force" -eq 0 ]; then
        if git merge-base --is-ancestor "$branch" HEAD; then
            log_ok "Rama $branch ya integrada en HEAD."
        elif [ "$(git rev-parse HEAD)" = "$(git merge-base HEAD "$branch")" ]; then
            log_err "HEAD no ha avanzado desde el resume de $branch."
            log_err "Commitea el trabajo resumido antes de 'wip done' (o usa --force)."
            exit 1
        else
            log_warn "HEAD avanzó pero $branch no es ancestro (commit con contenido distinto)."
        fi
    fi

    local_name="${branch#origin/}"
    if git show-ref --quiet --verify "refs/heads/$local_name"; then
        log_info "Borrando rama local $local_name..."
        git branch -d "$local_name"
    fi
    if git show-ref --quiet --verify "refs/remotes/origin/$local_name"; then
        log_info "Borrando rama remota origin/$local_name..."
        git push origin --delete "$local_name"
        git fetch --quiet --prune origin
    fi

    log_ok "Ciclo WIP cerrado en $current. Flujo normal."
}

# ---- dispatch ---------------------------------------------------------------
case "${1:-}" in
    park)   cmd_park "${2:-}" ;;
    resume) cmd_resume "${2:-}" ;;
    done)   cmd_done "${@:2}" ;;
    list)   cmd_list ;;
    *)      usage ;;
esac