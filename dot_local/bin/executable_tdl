#!/usr/bin/env bash
# tdl - Tmux Development Layout (Neovim + OpenCode + Shell)

set -euo pipefail

# 1. Determine agent command (default: opencode, or argument passed)
AGENT_CMD="${1:-opencode}"

# 2. Get sanitized session/project name from current directory
PROJECT_DIR="$(pwd)"
PROJECT_NAME="$(basename "$PROJECT_DIR" | tr '.: ' '---')"
SESSION_NAME="${PROJECT_NAME:-dev}"

if [ -n "${TMUX:-}" ]; then
    # --- INSIDE TMUX ---
    CURRENT_PANES=$(tmux display-message -p '#{window_panes}')
    if [ "$CURRENT_PANES" -eq 1 ]; then
        # Split right (40%) for OpenCode AI agent
        tmux split-window -h -p 40 "$AGENT_CMD"
        # Split bottom (50%) of the right pane for shell
        tmux split-window -v -p 50
        # Return focus to main left pane
        tmux select-pane -L
        # Replace current shell in main pane with Neovim
        exec "${EDITOR:-nvim}"
    else
        # Window already has multiple panes: open a new window in current dir
        tmux new-window -c "$PROJECT_DIR" -n "$PROJECT_NAME"
        tmux split-window -h -p 40 "$AGENT_CMD"
        tmux split-window -v -p 50
        tmux select-pane -L
        exec "${EDITOR:-nvim}"
    fi
else
    # --- OUTSIDE TMUX ---
    if tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
        # Session exists, attach to it
        exec tmux attach-session -t "=$SESSION_NAME"
    else
        # Create new detached session
        tmux new-session -d -s "$SESSION_NAME" -c "$PROJECT_DIR" -n "$PROJECT_NAME"
        # Split right (40%) for OpenCode AI agent
        tmux split-window -t "$SESSION_NAME" -h -p 40 "$AGENT_CMD"
        # Split bottom (50%) of right pane for shell
        tmux split-window -t "$SESSION_NAME" -v -p 50
        # Move focus back to the left pane
        tmux select-pane -t "$SESSION_NAME" -L
        # Send nvim to the left pane
        tmux send-keys -t "$SESSION_NAME" "${EDITOR:-nvim}" C-m
        # Attach to the session
        exec tmux attach-session -t "=$SESSION_NAME"
    fi
fi
