#!/usr/bin/env bash
# tdl - Tmux Development Layout (Neovim Personal + OpenCode + Terminal)
# Layout:
# +------------------------------------+-----------------------+
# |                                    |                       |
# |      Neovim Personal (65%)         |    OpenCode (35%)     |
# |                                    |                       |
# +------------------------------------+-----------------------+
# |                    Terminal Shell (20%)                    |
# +------------------------------------------------------------+

set -euo pipefail

# 1. Determine agent command (default: opencode, or argument passed)
AGENT_CMD="${1:-opencode}"

# 2. Determine editor command (defaults to nv / nvim-personal)
EDITOR_CMD="env NVIM_APPNAME=nvim-personal nvim"

# 3. Get sanitized session/project name from current directory
PROJECT_DIR="$(pwd)"
PROJECT_NAME="$(basename "$PROJECT_DIR" | tr '.: ' '---')"
SESSION_NAME="${PROJECT_NAME:-dev}"

if [ -n "${TMUX:-}" ]; then
    # --- INSIDE TMUX ---
    CURRENT_PANES=$(tmux display-message -p '#{window_panes}')
    if [ "$CURRENT_PANES" -eq 1 ]; then
        # 1. Split bottom (20% height) across full width for shell
        tmux split-window -v -p 20
        # 2. Focus top pane
        tmux select-pane -U
        # 3. Split top pane horizontally: right (35% width) for OpenCode
        tmux split-window -h -p 35 "$AGENT_CMD"
        # 4. Focus top-left pane for Neovim Personal
        tmux select-pane -L
        # 5. Run Neovim Personal in top-left pane
        exec $EDITOR_CMD
    else
        # Window already has multiple panes: open a new window in current dir
        tmux new-window -c "$PROJECT_DIR" -n "$PROJECT_NAME"
        tmux split-window -v -p 20
        tmux select-pane -U
        tmux split-window -h -p 35 "$AGENT_CMD"
        tmux select-pane -L
        exec $EDITOR_CMD
    fi
else
    # --- OUTSIDE TMUX ---
    if tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
        # Session exists, attach to it
        exec tmux attach-session -t "=$SESSION_NAME"
    else
        # Create new detached session
        tmux new-session -d -s "$SESSION_NAME" -c "$PROJECT_DIR" -n "$PROJECT_NAME"
        # 1. Split bottom (20% height) across full width for shell
        tmux split-window -t "$SESSION_NAME" -v -p 20
        # 2. Focus top pane
        tmux select-pane -t "$SESSION_NAME" -U
        # 3. Split top pane horizontally: right (35% width) for OpenCode
        tmux split-window -t "$SESSION_NAME" -h -p 35 "$AGENT_CMD"
        # 4. Move focus to top-left pane
        tmux select-pane -t "$SESSION_NAME" -L
        # 5. Send Neovim Personal command to top-left pane
        tmux send-keys -t "$SESSION_NAME" "$EDITOR_CMD" C-m
        # Attach to the session
        exec tmux attach-session -t "=$SESSION_NAME"
    fi
fi
