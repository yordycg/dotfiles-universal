#!/usr/bin/env bash
# tdl - Tmux Development Layout (Neovim + OpenCode + Shell)

set -euo pipefail

# 1. Determine agent command (default: opencode, or argument passed)
AGENT_CMD="${1:-opencode}"

# 2. Get sanitized session/project name from current directory
PROJECT_DIR="$(pwd)"
PROJECT_NAME="$(basename "$PROJECT_DIR" | tr '.: ' '---')"
SESSION_NAME="${PROJECT_NAME:-dev}"

setup_layout_panes() {
    local target="${1:-}"
    if [ -n "$target" ]; then
        tmux split-window -t "$target" -h -p 40 "$AGENT_CMD"
        tmux split-window -t "$target.1" -v -p 50
        tmux select-pane -t "$target.0"
    else
        tmux split-window -h -p 40 "$AGENT_CMD"
        tmux split-window -v -p 50
        tmux select-pane -t 0
    fi
}

if [ -n "${TMUX:-}" ]; then
    # --- INSIDE TMUX ---
    CURRENT_PANES=$(tmux display-message -p '#{window_panes}')
    if [ "$CURRENT_PANES" -eq 1 ]; then
        # Transform current 1-pane window into 3-pane layout
        tmux respawn-pane -k "${EDITOR:-nvim}"
        setup_layout_panes
    else
        # Window already has multiple panes: open a new window in current dir
        tmux new-window -c "$PROJECT_DIR" -n "$PROJECT_NAME" "${EDITOR:-nvim}"
        setup_layout_panes
    fi
else
    # --- OUTSIDE TMUX ---
    if tmux has-session -t "=$SESSION_NAME" 2>/dev/null; then
        # Session exists, attach to it
        exec tmux attach-session -t "=$SESSION_NAME"
    else
        # Create new detached session with nvim in main pane
        tmux new-session -d -s "$SESSION_NAME" -c "$PROJECT_DIR" -n "$PROJECT_NAME" "${EDITOR:-nvim}"
        # Set up 3-pane layout
        setup_layout_panes "$SESSION_NAME:0"
        # Attach to new session
        exec tmux attach-session -t "=$SESSION_NAME"
    fi
fi
