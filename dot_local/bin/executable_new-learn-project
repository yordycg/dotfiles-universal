#!/usr/bin/env bash

# new-learn-project (alias: new-learn)
# Descripción: Crea un nuevo repositorio de aprendizaje (Pilar 1: Learn).
# Incluye la Kata del Día, notas estructuradas con estándar @annotations,
# DAGs de descubrimiento y seguimiento unificado.
# Usa el template oficial de GitHub: yordycg/template-learn.

set -euo pipefail

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

PROJECT_NAME="${1:-}"

if [ -z "$PROJECT_NAME" ]; then
    echo -e "${YELLOW}Uso: $(basename "$0") <nombre_del_proyecto> [--private|--public]${NC}"
    exit 1
fi

VISIBILITY="${2:---private}"
TARGET_DIR="$(pwd)/$PROJECT_NAME"

if [ -d "$TARGET_DIR" ]; then
    echo -e "${RED}Error: El directorio $TARGET_DIR ya existe.${NC}"
    exit 1
fi

echo -e "${BLUE}Creando repositorio de aprendizaje '$PROJECT_NAME' desde yordycg/template-learn...${NC}"

if command -v gh &>/dev/null && gh auth status &>/dev/null; then
    gh repo create "$PROJECT_NAME" --template yordycg/template-learn "$VISIBILITY" --clone
else
    echo -e "${YELLOW}Aviso: 'gh' no autenticado o no disponible. Clonando vía git...${NC}"
    git clone https://github.com/yordycg/template-learn.git "$TARGET_DIR"
    rm -rf "$TARGET_DIR/.git"
    git -C "$TARGET_DIR" init > /dev/null
    git -C "$TARGET_DIR" add .
    git -C "$TARGET_DIR" commit -m "chore: initial learn project setup from template" > /dev/null
fi

echo -e "${GREEN}¡Entorno de aprendizaje '$PROJECT_NAME' listo en $TARGET_DIR!${NC}"
echo ""
if command -v eza &>/dev/null; then
    eza --tree --icons --level=2 "$TARGET_DIR" 2>/dev/null || ls -la "$TARGET_DIR"
else
    ls -la "$TARGET_DIR"
fi
echo ""
echo -e "${BLUE}Siguientes pasos:${NC}"
echo "  1. cd $PROJECT_NAME"
echo "  2. Inicia tu agente preferido (pi, opencode o agy)."
echo "  3. Pregunta: '¿Qué toca hoy?' para recibir el contrato de la Kata del Día."
echo "  4. Resuelve el ejercicio utilizando el bloque de comentarios /* @title ... */."
echo "  5. Cierra la sesión para persistir las notas en tu bóveda de Obsidian."
